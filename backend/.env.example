# IAM Drift Intelligence — Backend Environment Variables
# Copy to .env and fill in real values

# Storage backend: 'memory' (default, no AWS) or 'dynamodb'
STORAGE_BACKEND=memory

# DynamoDB endpoint override for local development
# DYNAMODB_ENDPOINT=http://localhost:8000

# DynamoDB table names (must match SAM template or setup-local-dynamo.sh)
DYNAMODB_TABLE_FINDINGS=iam-drift-findings
DYNAMODB_TABLE_SCANS=iam-drift-scans
DYNAMODB_TABLE_ACCOUNTS=iam-drift-accounts

# AI provider: 'anthropic' or 'bedrock'
AI_PROVIDER=anthropic

# Anthropic API key — required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Model override (optional — defaults to claude-sonnet-4-20250514)
# ANTHROPIC_MODEL=claude-sonnet-4-20250514

# AWS region
AWS_REGION=us-east-1

# Express dev server port
PORT=3001
